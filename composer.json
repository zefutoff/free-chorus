{
  "name": "free-chorus/free-chorus",
  "description": "Free Dolibarr module for Chorus Pro integration",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95.12",
    "phpstan/phpstan": "^2.2.5"
  },
  "scripts": {
    "lint": "find htdocs/custom/choruspro -name '*.php' -print0 | xargs -0 -n1 php -l",
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "analyse": "phpstan analyse htdocs/custom/choruspro/class --level=3"
  }
}
