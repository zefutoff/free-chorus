{
  "name": "free-chorus/dolibarr-choruspro",
  "description": "Module externe Dolibarr pour préparer l'intégration Chorus Pro.",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.0 <8.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^1.12"
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "lint": "find htdocs/custom/choruspro -type f -name '*.php' -print0 | xargs -0 -n1 php -l",
    "cs": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.php",
    "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.php",
    "analyse": "phpstan analyse --configuration=phpstan.neon",
    "test": "php tests/chorusproinvoiceservice_test.php && php tests/choruspro_extrafields_test.php"
  }
}
